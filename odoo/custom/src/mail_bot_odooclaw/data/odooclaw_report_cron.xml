<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Scheduled action: delete OdooClaw visual reports older than 7 days.
            noupdate="0" so the interval can be adjusted after module upgrades.
        -->
        <record id="ir_cron_cleanup_odooclaw_reports" model="ir.cron">
            <field name="name">OdooClaw: Clean up expired reports</field>
            <field name="model_id" ref="model_odooclaw_report"/>
            <field name="state">code</field>
            <field name="code">
model.sudo()._cron_cleanup_expired()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
